/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# CACHING. Two things to know before editing this.
#
# 1. Pages applies EVERY matching rule and concatenates the headers rather than
#    picking the most specific, so overlapping paths produce a Cache-Control
#    with two max-age values in it. The paths below deliberately do not
#    overlap: there is no "/assets/*" rule.
#
# 2. These only take effect because the zone's Browser Cache TTL is set to
#    "Respect Existing Headers" (Caching > Configuration). On the default of
#    4 hours Cloudflare rewrites max-age and nothing here matters.
#
# Nothing is content-hashed, so the stylesheet must never lag behind the HTML.
# On the sister site that pairing shipped a page whose @font-face rule was
# missing from the cached stylesheet.

/assets/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Only ever reached through the stylesheet, and contents do not change without
# a filename change.
/assets/fonts/*
  Cache-Control: public, max-age=604800

# Screenshots, the mark, the favicons and the link-preview card. Replaced in
# place occasionally, so keep the window short.
/assets/img/*
  Cache-Control: public, max-age=3600
/assets/og.jpg
  Cache-Control: public, max-age=3600
/assets/mark.png
  Cache-Control: public, max-age=3600
/assets/favicon-32.png
  Cache-Control: public, max-age=3600
/assets/favicon-64.png
  Cache-Control: public, max-age=3600
/assets/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
